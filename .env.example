# AI API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repo
GITHUB_DEFAULT_BRANCH=main

# Database
DATABASE_URL=sqlite+aiosqlite:///./plant.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Analysis Settings
ANOMALY_THRESHOLD=0.85
METRICS_INTERVAL=60
LOG_BATCH_SIZE=1000

# Auto-Fix Settings
AUTO_FIX_ENABLED=true
AUTO_PR_ENABLED=false
REQUIRE_APPROVAL=true

# Notification Settings
NOTIFICATIONS_ENABLED=true

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# OR use API token for more features:
# SLACK_API_TOKEN=xoxb-your-token-here
# SLACK_CHANNEL=#alerts

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=alerts@yourcompany.com
SMTP_TO_EMAILS=admin@yourcompany.com,ops@yourcompany.com

# PagerDuty (for critical incidents)
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key_here

# Alert Configuration
ALERT_DEDUP_WINDOW_MINUTES=15
ALERT_COOLDOWN_MINUTES=15
